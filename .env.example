SUPABASE_URL=
# Base project URL only, e.g. https://xxxxx.supabase.co
# Do NOT append /rest/v1/ or any other path, the code builds full paths from this.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

CF_ACCOUNT_ID=
CF_API_TOKEN=
# Cloudflare Workers AI — powers embeddings (2026-10-15 migration).
#
# EASIEST WAY TO GET BOTH VALUES: Cloudflare dashboard > AI > Workers AI >
# "Use REST API". That one screen shows the Account ID and has a button that
# creates a correctly-scoped token.
#
# If creating a token by hand instead, a CUSTOM token needs BOTH
# "Workers AI - Read" AND "Workers AI - Edit" (per Cloudflare's REST API guide,
# verified 2026-10-16 — Read alone is NOT enough).
#
# Do NOT use the Global API Key: it grants full access to the whole account,
# where this needs one product on one account.
#
# This replaced HF_TOKEN. HuggingFace removed its free tier (free accounts now
# get zero Inference credits), which took down uploads AND every question,
# since an embedding runs on each query. Cloudflare's bge-small-en-v1.5 was
# chosen because it outputs 384 dimensions — the exact width of the existing
# pgvector column — so no schema migration was needed.
#
# HF_TOKEN is no longer read anywhere — but delete it from the host only AFTER
# this code is deployed. The previous code reads it with os.environ["HF_TOKEN"]
# at import time, so removing it while the old code is still deployed crashes the
# service on startup ("exited with status 1"). That exact ordering mistake
# happened on 2026-10-17.

CF_EMBED_MODEL=
# Optional override, defaults to @cf/baai/bge-small-en-v1.5. Any replacement
# MUST output 384 dimensions or the pgvector column rejects it, and changing
# models means re-running backend/scripts/reembed.py over every stored chunk.

GROQ_GUARD_MODEL=
# Optional override, defaults to meta-llama/llama-prompt-guard-2-86m — the
# prompt-injection classifier, also moved off HuggingFace on 2026-10-15. It
# returns the injection probability as a plain number, so it is a drop-in for
# the previous score and INJECTION_SCORE_THRESHOLD is unchanged.

GROQ_VISION_MODEL=
# Optional override, defaults to qwen/qwen3.8-27b (OCR for scanned PDFs). The
# previous default qwen/qwen3.6-27b was retired by Groq on 2026-09-14 — set
# this if it happens again, no redeploy needed.

GROQ_API_KEY=
# Used by both the Synthesizer (backend/app/agents/synthesizer.py) and the
# query-text injection guard (backend/app/services/injection_guard.py).

GROQ_REPORT_MODEL=
GROQ_REPORT_MAP_MODEL=
# Optional (Sprint 4.6a, docs/ADR-022.md rev. 2). ALL report-generation calls
# default to openai/gpt-oss-120b — deliberately a different model than the Q&A
# pipeline's gpt-oss-20b, because Groq meters each model's free-tier rate
# limits separately (8k tokens/min each): a running report therefore consumes
# none of the interactive Q&A budget. Set these only to override — e.g. when
# Groq deprecates a model — no code change needed.

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional. If these are absent, Langfuse observability is cleanly disabled
# (one startup log line); research is never affected either way. Base URL must
# match the region your Langfuse Cloud project actually runs in — check
# Project Settings for the exact value. Known regions: EU (default)
# cloud.langfuse.com, US us.cloud.langfuse.com, Japan jp.cloud.langfuse.com.
# NOTE: the SDK v4 env var is LANGFUSE_BASE_URL, not LANGFUSE_HOST (renamed
# upstream). If you set LANGFUSE_HOST on Render from an earlier version of
# this file, rename it to LANGFUSE_BASE_URL — same value, new key name.

TAVILY_API_KEY=
# Sprint 3b (Web Scout). Optional — if unset, the Orchestrator can still set
# use_web=True but web_scout.py degrades cleanly to doc-only research with a
# banner (see docs/ADR-017.md). Also reused by Sprint 4.6a's report-template
# lookup, with the same degrade path. Get a key at tavily.com.

GEMINI_API_KEY=
GEMINI_MODEL=
# Sprint 4.5 (public project-Q&A chatbot, docs/ADR-021.md). Optional — if the
# key is unset the chatbot degrades to a graceful "resting" reply, nothing
# else is affected. Create the key in a SEPARATE Google Cloud project (quota
# isolation). GEMINI_MODEL overrides the default (gemini-3.1-flash-lite).

CHAT_MAX_PER_IP=
CHAT_MAX_PER_DAY=
# Optional chatbot rate-limit overrides (defaults: 6/min per IP, 300/day
# global). See main.py's chat rate-limiting block.
